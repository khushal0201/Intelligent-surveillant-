{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BehaviouralEvent",
  "type": "object",
  "required": [
    "event_id", "store_id", "camera_id", "visitor_id",
    "event_type", "timestamp", "zone_id", "dwell_ms",
    "is_staff", "confidence", "metadata"
  ],
  "properties": {
    "event_id":   { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "store_id":   { "type": "string" },
    "camera_id":  { "type": "string" },
    "visitor_id": { "type": "string", "pattern": "^VIS_[0-9a-f]{6}$" },
    "event_type": {
      "type": "string",
      "enum": [
        "ENTRY", "EXIT", "ZONE_ENTER", "ZONE_EXIT", "ZONE_DWELL",
        "BILLING_QUEUE_JOIN", "BILLING_QUEUE_ABANDON", "REENTRY"
      ]
    },
    "timestamp":  { "type": "string", "format": "date-time" },
    "zone_id":    { "type": ["string", "null"] },
    "dwell_ms":   { "type": "integer", "minimum": 0 },
    "is_staff":   { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "metadata": {
      "type": "object",
      "required": ["queue_depth", "sku_zone", "session_seq"],
      "properties": {
        "queue_depth": { "type": ["integer", "null"], "minimum": 0 },
        "sku_zone":    { "type": ["string", "null"] },
        "session_seq": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
